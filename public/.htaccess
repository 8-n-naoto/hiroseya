<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # robots.txt / sitemap.xml は「準備中モード」と連動させたいので、
    # 静的ファイルが置かれていても必ず Laravel 側で処理する。
    # （Apache は存在する静的ファイルを先に返してしまうため、この行が無いと
    #   古い robots.txt が残っている限り、準備中モードが効かない）
    RewriteRule ^(robots\.txt|sitemap\.xml)$ index.php [L]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# ---------------------------------------------------------------------------
# セキュリティヘッダー
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
    # ブラウザに内容の種類を推測させない（アップロードファイル経由の攻撃を防ぐ）
    Header always set X-Content-Type-Options "nosniff"
    # 他サイトからの iframe 埋め込みを禁じる（クリックジャッキング対策）
    Header always set X-Frame-Options "SAMEORIGIN"
    # 外部サイトへ渡すリファラを最小限にする
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # 使わない機能は最初から無効にしておく
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

    # 独自ドメインで常時 SSL の運用が始まったら、次の 1 行を有効にしてください。
    # 一度有効にするとブラウザ側が半年間 https を強制するため、
    # SSL証明書が確実に発行され、http→https のリダイレクトが動いてからにします。
    # Header always set Strict-Transport-Security "max-age=15552000; includeSubDomains"
</IfModule>

# ---------------------------------------------------------------------------
# 静的ファイルのキャッシュ
# build 配下のファイル名にはビルドごとのハッシュが付くので、長期キャッシュで安全。
# ---------------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/webp                "access plus 1 year"
    ExpiresByType image/jpeg                "access plus 1 year"
    ExpiresByType image/png                 "access plus 1 year"
    ExpiresByType image/svg+xml             "access plus 1 year"
    ExpiresByType text/css                  "access plus 1 year"
    ExpiresByType application/javascript    "access plus 1 year"
    ExpiresByType text/html                 "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|webp|jpg|jpeg|png|svg|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(html|php)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# ---------------------------------------------------------------------------
# 圧縮
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
    AddOutputFilterByType DEFLATE application/javascript application/json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>
