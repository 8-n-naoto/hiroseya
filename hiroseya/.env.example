APP_NAME="広瀬屋"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ja
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ja_JP
APP_TIMEZONE=Asia/Tokyo

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ローカル開発は sqlite のままで動きます。
# 本番（エックスサーバー）は mysql に切り替えてください。
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log

# アップロード画像は storage/app/public に置き、storage:link で公開する。
# エックスサーバーでシンボリックリンクが効かない場合の代替は docs/SETUP.md を参照。
FILESYSTEM_DISK=public

# 共用サーバーでは常駐プロセスが使えないため、cron で 1 分毎に
# queue:work --stop-when-empty を回す前提の database ドライバ。
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# メール設定は管理画面（/admin/settings のメール）から変更できる。
# ここは開発用の既定値で、本番では DB 側の設定が優先される。
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
